# ============================================================================
# CREATEDOT / DESIGNDOT - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.local and populate with your project credentials:
# cp .env.example .env.local
# ============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (Safe to expose in browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Application URL (for OAuth callbacks and email redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google Gemini AI (for Studio AI generation)
GEMINI_API_KEY=your-gemini-api-key-here
