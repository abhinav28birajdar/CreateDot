# ============================================================================
# DESIGN.LY - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env.local and fill in with your actual values
# NEVER commit .env.local to git - it's added to .gitignore
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================================================
# Get these values from: Supabase Dashboard → Project Settings → API

# Your Supabase project URL
# Example: https://abcxyz123.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (PUBLIC - safe to expose in browser)
# Used for client-side operations with RLS protection
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (PRIVATE - server-side only)
# Used for server-side operations that bypass RLS
# NEVER expose this key in client code or browser!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# GOOGLE GEMINI AI (OPTIONAL - for AI features)
# ============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
# Leave blank if you don't want AI features

# Google Generative AI API Key for image/text generation
NEXT_PUBLIC_GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application name (used in meta tags, emails, etc.)
NEXT_PUBLIC_APP_NAME=Design.ly

# Application URL (change for production)
# Development: http://localhost:3000
# Production: https://designly.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, staging, production)
NODE_ENV=development

# ============================================================================
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# ============================================================================

# Analytics (Google Analytics, Mixpanel, etc.)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXX

# Email Service (SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# WebSocket/Real-time (Socket.IO)
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ============================================================================
# SECURITY & RATE LIMITING
# ============================================================================

# CORS allowed origins (production: your domain only)
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:3000

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Debug mode (set to false in production)
NEXT_PUBLIC_DEBUG=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
# 🔒 RULES TO FOLLOW:
# 1. NEVER commit .env.local or any .env file with real values
# 2. NEVER share your Service Role Key or API keys
# 3. NEVER paste secrets in code, comments, or logs
# 4. ALWAYS use environment variables for secrets
# 5. ALWAYS rotate keys after any suspected compromise
# 6. ALWAYS use HTTPS in production
# 7. ALWAYS enable RLS on Supabase tables
# 8. ALWAYS validate user input
# 9. ALWAYS use strong passwords
# 10. ALWAYS enable 2FA on external accounts

# For more information:
# - Supabase Docs: https://supabase.com/docs
# - Next.js Env: https://nextjs.org/docs/basic-features/environment-variables
# - Security Best Practices: https://owasp.org/
# Get from: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Discord OAuth
# Get from: https://discord.com/developers/applications
# DISCORD_CLIENT_ID=your-discord-client-id
# DISCORD_CLIENT_SECRET=your-discord-client-secret

# ============================================================================
# STORAGE - FILE UPLOADS
# ============================================================================
# Supabase Storage is included by default. For external storage:

# Cloudinary (optional)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (optional)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# ============================================================================
# AI FEATURES (Optional)
# ============================================================================

# OpenAI for AI features
# OPENAI_API_KEY=your-openai-api-key

# ============================================================================
# EMAIL (Optional - Supabase handles auth emails)
# ============================================================================
# For custom transactional emails:

# Resend
# RESEND_API_KEY=your-resend-api-key

# SendGrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# ============================================================================
# PAYMENTS (Optional)
# ============================================================================

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# RATE LIMITING & SECURITY
# ============================================================================

# Upstash Redis for rate limiting (optional)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# ============================================================================
# DEVELOPMENT
# ============================================================================

# Enable debug logging
# DEBUG=true

# Skip email verification in development
# SKIP_EMAIL_VERIFICATION=true

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. PRIMARY DATABASE (REQUIRED)
#    - Create a Supabase project at https://supabase.com
#    - Run `supabase/schema-complete.sql` in SQL Editor
#    - Copy URL and keys to env vars above
#
# 2. ANALYTICS DATABASE (OPTIONAL)
#    - Create a second Supabase project
#    - Run `supabase/schema-analytics.sql` in SQL Editor
#    - Copy URL and keys to env vars above
#
# 3. ENABLE REALTIME
#    In Supabase Dashboard > Database > Replication:
#    - Enable replication for tables: messages, notifications, 
#      likes, comments, followers, activities
#
# 4. CONFIGURE STORAGE BUCKETS
#    In Supabase Dashboard > Storage:
#    - Create buckets: avatars, projects, covers, attachments
#    - Set appropriate RLS policies
#
# 5. SET UP AUTHENTICATION
#    In Supabase Dashboard > Authentication:
#    - Configure redirect URLs
#    - Enable desired OAuth providers
#    - Customize email templates
#
# ============================================================================
