# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ============================================================================
# DEPENDENCIES & PACKAGE MANAGERS
# ============================================================================
/node_modules
/.pnp
.pnp.*
/yarn.lock
/package-lock.json
/pnpm-lock.yaml
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.eslintcache

# ============================================================================
# ENVIRONMENT & CONFIGURATION
# ============================================================================
# Environment files - Never commit sensitive data
.env
.env.local
.env.*.local
!.env.example
!.env.local.example
.env.production
.env.development
.env.test
.env.testing

# ============================================================================
# BUILD & COMPILATION
# ============================================================================
/.next/
/out/
/build/
/dist/
.next
next-env.d.ts
*.tsbuildinfo
*.js.map
*.css.map

# ============================================================================
# TESTING & COVERAGE
# ============================================================================
/coverage
/.nyc_output
/test-results
junit.xml
coverage.xml

# ============================================================================
# IDE & EDITOR
# ============================================================================
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.project
.classpath
.c9/
*.sublime-project
*.sublime-workspace
.emacs.desktop*
.tern-port

# ============================================================================
# LOGS & DEBUG
# ============================================================================
npm-debug.log*
npm-debug.log*.*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
build*.log
debug.log
pip-log.txt
pip-delete-this-directory.txt

# ============================================================================
# OS SPECIFIC
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================================
# TEMPORARY & BUILD ARTIFACTS
# ============================================================================
*.pem
*.key
*.crt
.cache/
.parcel-cache/
dist/
build/
*.tgz

# ============================================================================
# DEPLOYMENT & HOSTING
# ============================================================================
.vercel
.netlify
.env.local.example
.env.production.local
.env.*.example

# ============================================================================
# MISC DEVELOPMENT FILES
# ============================================================================
.husky/
.gitignore.backup
*.orig
*.rej
*.patch
.code-workspace

# ============================================================================
# LARGE FILES & MEDIA (Optional - adjust as needed)
# ============================================================================
# Uncomment if you want to exclude large media files
# *.mp4
# *.mov
# *.zip
# *.rar
